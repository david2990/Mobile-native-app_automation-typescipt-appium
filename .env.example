# ---------------------------------------------------------------------------
# Device under test
# ---------------------------------------------------------------------------
# Must match an AVD name (emulator) or the adb serial of a physical device.
DEVICE_NAME=Pixel_API_35
# Optional: pin a specific device when several are attached (adb devices -l).
# DEVICE_UDID=emulator-5554
PLATFORM_VERSION=15

# ---------------------------------------------------------------------------
# App under test
# ---------------------------------------------------------------------------
# Path to the .apk, relative to the project root or absolute.
APP_PATH=apps/app-under-test.apk
# Leave both empty to let Appium detect the launchable activity from the APK.
# APP_PACKAGE=com.example.app
# APP_ACTIVITY=.MainActivity

# Wipe app data between runs (false keeps the installed state).
NO_RESET=false

# ---------------------------------------------------------------------------
# Appium server
# ---------------------------------------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# ---------------------------------------------------------------------------
# Execution tuning
# ---------------------------------------------------------------------------
EXPLICIT_WAIT_MS=15000
MAX_INSTANCES=1
