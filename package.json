{
  "name": "apk-mobile-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Appium + WebdriverIO framework for native Android (.apk) UI test automation",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:regression": "wdio run wdio.conf.ts --spec ./tests/android/regression/**/*.spec.ts",
    "appium:driver": "appium driver install uiautomator2",
    "appium:doctor": "appium driver doctor uiautomator2",
    "devices": "adb devices -l",
    "emulator:start": "node scripts/emulator.mjs start",
    "emulator:stop": "node scripts/emulator.mjs stop",
    "fetch:app": "node scripts/fetch-demo-app.mjs",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/appium-service": "^10.0.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/html-reporter": "^10.0.0",
    "@wdio/junit-reporter": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "@wdio/types": "^10.0.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^4.0.0"
  }
}
